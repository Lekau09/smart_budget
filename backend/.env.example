# Database Configuration — SmartSpend Backend
# =============================================
# 1. Copy this file:   copy backend\.env.example backend\.env
# 2. Fill in your values below (the .env file is git-ignored)

# MySQL host (leave as localhost for XAMPP)
DB_HOST=localhost

# Database name (created automatically by: make setup-db)
DB_NAME=smart_budget

# MySQL username (XAMPP default is root)
DB_USER=root

# MySQL password (XAMPP default is blank — leave empty if you haven't set one)
DB_PASS=

# Optional: switch between XAMPP and MySQL Workbench connection presets
# Values: XAMPP | WORKBENCH  (default: XAMPP)
DB_ENV=XAMPP

# URL of the PHP backend (used by the SMS extractor to save transactions)
# XAMPP default port is 80 — if you changed it in httpd.conf, update here
BACKEND_URL=http://localhost/smart_budget/backend/api
